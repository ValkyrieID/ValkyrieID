<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ValkyrieID.Data.Sqlite\ValkyrieID.Data.Sqlite.csproj" />
    <ProjectReference Include="..\ValkyrieID.Data.PostgreSql\ValkyrieID.Data.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>valkyrieid</AssemblyName>
    <RootNamespace>ValkyrieID.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ValkyrieID.Server.IntegrationTests" />
  </ItemGroup>

  <!--
    The admin UI (src/ValkyrieID.AdminUI) builds into wwwroot/admin (git-ignored). It is not a static web asset of
    this project; the server serves it itself (AdminUi/AdminUiExtensions.cs). `dotnet publish` builds it and adds it
    to the output; pass -p:SkipAdminUI=true to publish without it (e.g. when CI built it in a separate step).
  -->
  <PropertyGroup>
    <AdminUIProjectDir>$(MSBuildProjectDirectory)\..\ValkyrieID.AdminUI\</AdminUIProjectDir>
    <AdminUIOutputDir>$(MSBuildProjectDirectory)\wwwroot\admin\</AdminUIOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\admin\**" />
    <None Remove="wwwroot\admin\**" />
  </ItemGroup>

  <Target Name="BuildAdminUI" BeforeTargets="ComputeFilesToPublish" Condition="'$(SkipAdminUI)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(AdminUIProjectDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(AdminUIProjectDir)" />
  </Target>

  <!--
    The branding files live once, in assets/branding. Before each build they are copied into wwwroot (git-ignored), so
    the static files keep the names the pages use. The logo-192.png name is the same file as android-chrome-192x192.png.
  -->
  <Target Name="CopyBranding" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <BrandingDir>$(MSBuildProjectDirectory)\..\..\assets\branding\</BrandingDir>
      <BrandingOutDir>$(MSBuildProjectDirectory)\wwwroot\img\</BrandingOutDir>
    </PropertyGroup>
    <ItemGroup>
      <BrandingFile Include="$(BrandingDir)wall-light.png;$(BrandingDir)wall-dark.png;$(BrandingDir)favicon-16x16.png;$(BrandingDir)favicon-32x32.png;$(BrandingDir)apple-touch-icon.png" />
    </ItemGroup>
    <Copy SourceFiles="@(BrandingFile)" DestinationFolder="$(BrandingOutDir)" />
    <Copy SourceFiles="$(BrandingDir)android-chrome-192x192.png" DestinationFiles="$(BrandingOutDir)logo-192.png" />
    <Copy SourceFiles="$(BrandingDir)favicon.ico" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot" />
  </Target>

  <Target Name="PublishAdminUI" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <AdminUIFiles Include="$(AdminUIOutputDir)**" />
      <ResolvedFileToPublish Include="@(AdminUIFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\admin\%(AdminUIFiles.RecursiveDir)%(AdminUIFiles.Filename)%(AdminUIFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
