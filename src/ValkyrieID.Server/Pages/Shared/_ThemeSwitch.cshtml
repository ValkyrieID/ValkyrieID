@using ValkyrieID.Server.Configuration
@{
    var current = ThemePreference.Read(Context.Request) ?? ThemePreference.System;
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    // Icon markup is constant; nothing user-controlled is rendered raw.
    (string Value, string Label, string Icon)[] themes =
    [
        (ThemePreference.System, "System theme", """<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>"""),
        (ThemePreference.Light, "Light theme", """<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>"""),
        (ThemePreference.Dark, "Dark theme", """<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>"""),
    ];
}
<form method="post" asp-page="/Account/Theme" class="theme-switch">
    <input type="hidden" name="ReturnUrl" value="@returnUrl">
    <fieldset>
        <legend class="visually-hidden">Color theme</legend>
        @foreach (var (value, label, icon) in themes)
        {
            <button type="submit" name="Theme" value="@value" aria-pressed="@(value == current ? "true" : "false")" aria-label="@label" title="@label"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@Html.Raw(icon)</svg></button>
        }
    </fieldset>
</form>
