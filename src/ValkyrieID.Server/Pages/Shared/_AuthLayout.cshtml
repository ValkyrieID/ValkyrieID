@{
    Layout = "_Layout";
}
@* Sign-in layout (layout.md, Phase 11b): the wallpaper fills the page, with the brand lockup beside the glass card. *@
<body class="auth">
    <header class="auth-top">
        <partial name="_ThemeSwitch" />
    </header>
    <div class="auth-layout">
        <div class="auth-lockup">
            <partial name="_Brand" />
        </div>
        <main class="auth-card">
            @RenderBody()
        </main>
    </div>
</body>
