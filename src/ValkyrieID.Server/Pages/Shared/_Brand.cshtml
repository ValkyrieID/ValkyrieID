@using Microsoft.Extensions.Options
@using ValkyrieID.Server.Configuration
@inject IOptionsMonitor<BrandingOptions> BrandingOptions
@{
    var branding = BrandingOptions.CurrentValue;
}
<div class="brand">
    @if (branding.Logo is not null)
    {
        <img src="~/branding/@branding.Logo" alt="@branding.ProductName">
    }
    else
    {
        @* Decorative: the product name next to it is the accessible name (WCAG 1.1.1). *@
        <img src="~/img/logo-192.png" alt="" width="32" height="32">
        @if (branding.ProductName == ValkyrieID.Server.Configuration.BrandingOptions.DefaultProductName)
        {
            @* The "Valkyrie id" wordmark is visual only; assistive technology reads the product name. *@
            <span class="product-name"><span class="visually-hidden">@branding.ProductName</span><span aria-hidden="true">Valkyrie<span class="product-name-suffix">id</span></span></span>
        }
        else
        {
            <span class="product-name">@branding.ProductName</span>
        }
    }
</div>
