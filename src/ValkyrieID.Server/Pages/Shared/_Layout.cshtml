@using Microsoft.Extensions.Options
@using ValkyrieID.Server.Configuration
@inject IOptionsMonitor<BrandingOptions> BrandingOptions
@{
    var branding = BrandingOptions.CurrentValue;
    // Rendered on the server so the chosen theme shows without any script (strict CSP, PROJECT.md §8.1).
    var current = ThemePreference.Read(Context.Request) ?? ThemePreference.System;
    // Set by the entry pages on a fresh GET only (layout.md, Phase 11b motion); CSS plays the animation.
    var entry = ViewData[ValkyrieID.Server.Pages.EntryAnimation.Key] is true ? "entry" : null;
}
<!DOCTYPE html>
<html lang="en" data-theme="@current" class="@entry">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>@ViewData["Title"] – @branding.ProductName</title>
    <link rel="icon" href="~/favicon.ico" sizes="32x32">
    <link rel="icon" href="~/img/favicon-32x32.png" type="image/png">
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/theme.css">
    @if (branding.CustomCss is not null)
    {
        <link rel="stylesheet" href="~/branding/@branding.CustomCss">
    }
</head>
@RenderBody()
</html>
