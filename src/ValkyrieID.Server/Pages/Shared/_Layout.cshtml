@using Microsoft.Extensions.Options
@using ValkyrieID.Server.Configuration
@inject IOptionsMonitor<BrandingOptions> BrandingOptions
@{
    var branding = BrandingOptions.CurrentValue;
    // Rendered on the server so the chosen theme shows without any script (strict CSP, PROJECT.md §8.1).
    var current = ThemePreference.Read(Context.Request) ?? ThemePreference.System;
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    (string Value, string Label)[] themes = [(ThemePreference.System, "System"), (ThemePreference.Light, "Light"), (ThemePreference.Dark, "Dark")];
}
<!DOCTYPE html>
<html lang="en" data-theme="@current">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>@ViewData["Title"] – @branding.ProductName</title>
    <link rel="icon" href="~/favicon.ico" sizes="32x32">
    <link rel="icon" href="~/img/favicon-32x32.png" type="image/png">
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/theme.css">
    @if (branding.CustomCss is not null)
    {
        <link rel="stylesheet" href="~/branding/@branding.CustomCss">
    }
</head>
<body>
    @* First in the page order, matching its position at the top right (WCAG 1.3.2, 2.4.3). *@
    <header class="site-header">
        <form method="post" asp-page="/Account/Theme" class="theme-switch">
            <input type="hidden" name="ReturnUrl" value="@returnUrl">
            <fieldset>
                <legend class="visually-hidden">Color theme</legend>
                @foreach (var (value, label) in themes)
                {
                    <button type="submit" name="Theme" value="@value" aria-pressed="@(value == current ? "true" : "false")">@label</button>
                }
            </fieldset>
        </form>
    </header>
    <main class="card">
        <header class="brand">
            @if (branding.Logo is not null)
            {
                <img src="~/branding/@branding.Logo" alt="@branding.ProductName">
            }
            else
            {
                @* Decorative: the product name next to it is the accessible name (WCAG 1.1.1). *@
                <img src="~/img/logo-192.png" alt="" width="64" height="64">
                <p class="product-name">@branding.ProductName</p>
            }
        </header>
        @RenderBody()
    </main>
</body>
</html>
