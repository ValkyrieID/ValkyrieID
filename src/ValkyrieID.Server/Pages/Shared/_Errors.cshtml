@model IReadOnlyList<string>
@if (Model.Count > 0)
{
    <div class="alert" role="alert" id="errors" tabindex="-1">
        @if (Model.Count == 1)
        {
            <p>@Model[0]</p>
        }
        else
        {
            <ul>
                @foreach (var error in Model)
                {
                    <li>@error</li>
                }
            </ul>
        }
    </div>
}
