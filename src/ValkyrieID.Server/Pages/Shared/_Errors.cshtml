@model IReadOnlyList<string>
@* autofocus: the summary gets the focus on load, without JavaScript, so screen readers read it first (WCAG 3.3.1). *@
@if (Model.Count > 0)
{
    <div class="alert" role="alert" id="errors" tabindex="-1" autofocus>
        @if (Model.Count == 1)
        {
            <p>@Model[0]</p>
        }
        else
        {
            <ul>
                @foreach (var error in Model)
                {
                    <li>@error</li>
                }
            </ul>
        }
    </div>
}
