@page
@model SessionsModel
@{
    ViewData["Title"] = "Your sessions";
    Layout = "_AccountLayout";
}
<div class="page-header">
    <p class="back"><a href="~/account">Your account</a></p>
    <h1>Your sessions</h1>
    <p class="lead">These are the browsers and devices where you're signed in. Signing a session out also signs it out of applications that support it.</p>
</div>
@if (Model.Message is not null)
{
    <p role="status" class="notice">@Model.Message</p>
}
<partial name="_Errors" model="Model.Errors" />
<ul class="sessions">
    @foreach (var session in Model.Sessions)
    {
        var nameId = $"session-{session.Id}";
        var current = Model.IsCurrent(session);
        <li class="session@(current ? " session-current" : null)">
            <p class="session-name">
                <strong id="@nameId">@(session.UserAgent ?? "Unknown device")</strong>
                @if (current)
                {
                    <span class="badge">This session</span>
                }
            </p>
            <dl class="session-meta">
                <div><dt>IP address</dt> <dd><code>@(session.IpAddress ?? "Unknown")</code></dd></div>
                <div><dt>Signed in</dt> <dd><time datetime="@session.AuthenticatedAt.ToString("O")">@session.AuthenticatedAt.ToString("u")</time></dd></div>
                <div><dt>Last activity</dt> <dd><time datetime="@session.LastActivityAt.ToString("O")">@session.LastActivityAt.ToString("u")</time></dd></div>
            </dl>
            <form method="post" asp-page-handler="Revoke" class="actions">
                <input type="hidden" name="SessionId" value="@session.Id">
                @* The buttons all have the same name; the description tells them apart (WCAG 2.4.6). *@
                <button type="submit" class="button-secondary" aria-describedby="@nameId">@(current ? "Sign out" : "Sign out this session")</button>
            </form>
        </li>
    }
</ul>
@if (Model.Sessions.Any(s => !Model.IsCurrent(s)))
{
    <section class="danger-zone" aria-labelledby="others-heading">
        <h2 id="others-heading">Other sessions</h2>
        <p>Sign out every browser and device except this one.</p>
        <form method="post" asp-page-handler="RevokeOthers" class="actions">
            <button type="submit" class="button-danger">Sign out all other sessions</button>
        </form>
    </section>
}
