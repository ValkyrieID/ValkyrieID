@page "/account/forgot-password"
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<h1>Forgot password</h1>
@if (Model.Sent)
{
    <p role="status">If an account with an email address exists for what you entered, we've sent it a link to reset the password. The link works once and expires soon.</p>
    <p><a href="~/account/login">Back to sign in</a></p>
}
else
{
    <p>Enter your username or email address, and we'll email you a link to choose a new password.</p>
    <form method="post" novalidate>
        <div class="field">
            <label for="identifier">Username or email</label>
            <input id="identifier" name="Identifier" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
        </div>
        <button type="submit">Send reset link</button>
    </form>
    <p class="secondary"><a href="~/account/login">Back to sign in</a></p>
}
