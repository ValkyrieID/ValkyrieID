@page
@using Microsoft.Extensions.Options
@using ValkyrieID.Server.Configuration
@model IndexModel
@inject IOptionsMonitor<SmtpOptions> Smtp
@{
    ViewData["Title"] = "Your account";
}
<h1>Your account</h1>
<p>You are signed in as <strong>@User.Identity?.Name</strong>.</p>
<ul class="links">
    <li><a href="~/account/profile">Profile</a></li>
    @if (Smtp.CurrentValue.Enabled)
    {
        <li><a href="~/account/email">Email address</a></li>
    }
    <li><a href="~/account/password">Change password</a></li>
    <li><a href="~/account/two-factor">Two-factor authentication</a></li>
    <li><a href="~/account/sessions">Your sessions</a></li>
    <li><a href="~/account/logout">Sign out</a></li>
</ul>
