@page
@using Microsoft.Extensions.Options
@using ValkyrieID.Server.Configuration
@model IndexModel
@inject IOptionsMonitor<SmtpOptions> Smtp
@{
    ViewData["Title"] = "Your account";
    Layout = "_AccountLayout";
    var user = Model.CurrentUser;
}
<div class="page-header">
    <h1>Your account</h1>
    <p class="lead">You are signed in as <strong>@User.Identity?.Name</strong>. Manage your details, sign-in security, and sessions.</p>
</div>

<section aria-labelledby="details-heading">
    <h2 id="details-heading" class="list-heading">Your details</h2>
    <ul class="link-list">
        <li>
            <a href="~/account/profile">
                <span class="link-list-title">Profile</span>
                <span class="link-list-text">Your display name and full name.</span>
            </a>
        </li>
        @if (Smtp.CurrentValue.Enabled)
        {
            <li>
                <a href="~/account/email">
                    <span class="link-list-title">Email address</span>
                    <span class="link-list-text">@(user?.Email is null ? "Add an email address." : user.EmailVerified ? "Change your email address." : "Verify or change your email address.")</span>
                </a>
            </li>
        }
    </ul>
</section>

<section aria-labelledby="security-heading">
    <h2 id="security-heading" class="list-heading">Sign-in and security</h2>
    <ul class="link-list">
        <li>
            <a href="~/account/password">
                <span class="link-list-title">Password</span>
                <span class="link-list-text">Change your password.</span>
            </a>
        </li>
        <li>
            <a href="~/account/two-factor">
                <span class="link-list-title">Two-factor authentication <span class="link-list-status">@(user?.TwoFactorEnabled == true ? "On" : "Off")</span></span>
                <span class="link-list-text">@(user?.TwoFactorEnabled == true ? "Manage your recovery codes." : "Add a code from an authenticator app.")</span>
            </a>
        </li>
        <li>
            <a href="~/account/sessions">
                <span class="link-list-title">Sessions</span>
                <span class="link-list-text">See where you're signed in and sign out other devices.</span>
            </a>
        </li>
    </ul>
</section>
